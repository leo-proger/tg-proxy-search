# Optional — all have sane defaults, uncomment only to override.
# Run parameters (how many proxies / which time window) are chosen in the UI.

# AUTO_ADD_TO_TELEGRAM=false       # open each working proxy in Telegram afterwards
# TCP_TIMEOUT=15                   # seconds per proxy connection attempt (raise for slow/high-ping proxies)
# PROXY_CHECK_CONCURRENCY=8        # how many proxies to test in parallel (lower = fewer false negatives)
# MAX_SCAN_MESSAGES=1000           # safety cap on channel messages scanned per fetch
# PROXY_WORKING_RECHECK_HOURS=48   # re-test a cached working proxy after this long
# PROXY_FAILED_RECHECK_HOURS=24    # re-test a cached failed proxy after this long
