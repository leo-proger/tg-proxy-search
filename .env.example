# Опционально — личные ключи с my.telegram.org.
# Если не указаны, используются ключи Telegram Desktop (могут быть строже по лимитам).
# API_ID=ваш_api_id
# API_HASH=ваш_api_hash

# Опционально — все имеют разумные значения по умолчанию, раскомментируйте только для переопределения.
# Параметры запуска (сколько прокси искать, временное окно) выбираются в UI.

# AUTO_ADD_TO_TELEGRAM=false       # открывать каждый рабочий прокси в Telegram после проверки
# TCP_TIMEOUT=15                   # таймаут подключения к одному прокси в секундах
# PROXY_CHECK_CONCURRENCY=8        # сколько прокси проверять параллельно (меньше = меньше ложных провалов)
# MAX_SCAN_MESSAGES=1000           # лимит сообщений канала за один запуск парсинга
# PROXY_WORKING_RECHECK_HOURS=48   # через сколько часов перепроверять рабочий прокси
# PROXY_FAILED_RECHECK_HOURS=24    # через сколько часов перепроверять нерабочий прокси
